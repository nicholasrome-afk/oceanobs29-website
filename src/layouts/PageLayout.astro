---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import UtilityBar from '~/components/site/UtilityBar.astro';
import SiteFooter from '~/components/site/SiteFooter.astro';

import { headerData } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */
  }
  <a
    href="#main"
    class="sr-only z-[60] rounded-[4px] bg-primary px-4 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:px-4 focus:py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
  >
    Skip to content
  </a>
  {Astro.slots.has('announcement') ? <slot name="announcement" /> : <UtilityBar />}
  {Astro.slots.has('header') ? <slot name="header" /> : <Header {...headerData} isSticky position="right" />}
  <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <SiteFooter />}
</Layout>
