---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import EventCard from '~/components/site/EventCard.astro';
import DayFilter from '~/components/site/DayFilter.astro';

import { ORG } from '~/config/org';
import { CONFERENCES } from '~/config/home';
import { getEvents, splitByTime, groupByConference, dayOfMonth, fullDate } from '~/utils/events';

const metadata = {
  title: 'Events',
  description: `Conferences, sessions and workshops from ${ORG.name} and its partners.`,
};

const events = await getEvents();
const { upcoming, past } = splitByTime(events);
const pastGroups = [...groupByConference(past).entries()];

const dateSpan = (list: typeof events) => {
  const first = list[0].data.date;
  const last = list[list.length - 1].data.date;
  return first.getTime() === last.getTime() ? fullDate(first) : `${dayOfMonth(first)}–${fullDate(last)}`;
};
---

<Layout metadata={metadata}>
  <!-- Page header -->
  <section class="bg-ink">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-20 lg:px-6">
      <p class="eyebrow-bar text-on-dark-muted before:bg-accent">Events</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white md:text-6xl">Events</h1>
      <p class="mt-4 max-w-2xl text-lg text-on-dark-muted">
        Conferences, sessions and workshops from {ORG.name} and its partners.
      </p>
    </div>
  </section>

  <!-- Upcoming -->
  <section class="py-16 md:py-20" aria-labelledby="upcoming">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <p class="eyebrow-bar text-muted">What's next</p>
      <h2 id="upcoming" class="mt-3 text-3xl font-bold tracking-tight text-heading md:text-4xl">Upcoming events</h2>
      {
        upcoming.length ? (
          <ul class="mt-8 grid gap-4">
            {upcoming.map((event) => (
              <li>
                <EventCard event={event} />
              </li>
            ))}
          </ul>
        ) : (
          <div class="mt-8 flex flex-col gap-4 rounded-[4px] border border-dashed border-line bg-mist p-8 md:flex-row md:items-center md:justify-between">
            <p class="text-lg text-default">
              No upcoming events are listed right now.
              {ORG.newsletterUrl && ' The newsletter is the best way to hear about the next ones.'}
            </p>
            {ORG.newsletterUrl && (
              <a href={ORG.newsletterUrl} class="btn-site-primary shrink-0">
                <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" /> Subscribe
              </a>
            )}
          </div>
        )
      }
    </div>
  </section>

  <!-- Past, grouped by conference -->
  {
    pastGroups.map(([key, list]) => {
      const conf = CONFERENCES[key];
      const id = `conf-${key.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
      return (
        <section class="border-t border-line bg-mist py-16 md:py-20" aria-labelledby={id}>
          <div class="mx-auto max-w-7xl px-4 lg:px-6">
            <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="eyebrow-bar text-muted">Past events</p>
                <h2 id={id} class="mt-3 text-3xl font-bold tracking-tight text-heading md:text-4xl">
                  {ORG.shortName} events at {key}
                </h2>
                <p class="eyebrow mt-3 text-muted">
                  {[conf?.name, conf?.place, dateSpan(list), `${list.length} events`].filter(Boolean).join(' · ')}
                </p>
              </div>
              {conf?.programmeUrl && (
                <a
                  href={conf.programmeUrl}
                  class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-link underline-offset-4 hover:underline"
                >
                  Entire scientific programme <Icon name="tabler:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
                </a>
              )}
            </div>
            <div class="mt-8">
              <DayFilter events={list} id={id} label={key} />
            </div>
          </div>
        </section>
      );
    })
  }
</Layout>
