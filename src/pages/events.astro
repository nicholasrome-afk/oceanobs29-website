---
// News & Events: announcements (src/data/post), planning milestones
// (src/data/roadmap.ts) and events (src/data/events). Empty parts are hidden.
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import EventCard from '~/components/site/EventCard.astro';
import DayFilter from '~/components/site/DayFilter.astro';

import { ORG } from '~/config/org';
import { CONFERENCES } from '~/config/home';
import { ROADMAP } from '~/data/roadmap';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getEvents, splitByTime, groupByConference, dayOfMonth, fullDate } from '~/utils/events';

const metadata = {
  title: 'News & Events',
  description: `Announcements, planning milestones, workshops and events from ${ORG.name}.`,
};

const posts = await findLatestPosts({ count: 6 });
const postDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const events = await getEvents();
const { upcoming, past } = splitByTime(events);
const pastGroups = [...groupByConference(past).entries()];

const dateSpan = (list: typeof events) => {
  const first = list[0].data.date;
  const last = list[list.length - 1].data.date;
  return first.getTime() === last.getTime() ? fullDate(first) : `${dayOfMonth(first)}–${fullDate(last)}`;
};
---

<Layout metadata={metadata}>
  <PageHeader
    eyebrow="News & Events"
    title="News & Events"
    intro="Announcements, planning milestones, workshops and upcoming events on the road to OceanObs’29."
  />

  <!-- News -->
  {
    posts.length > 0 && (
      <section class="py-16 md:py-20" aria-labelledby="news">
        <div class="mx-auto max-w-7xl px-4 lg:px-6">
          <SectionHead id="news" eyebrow="News" title="Announcements" />
          <ul class="mt-10 grid border-t border-line md:grid-cols-3 md:border-t-0">
            {posts.map((post, i) => (
              <li
                class:list={[
                  'border-b border-line py-6 md:border-t-4 md:border-b-0 md:border-t-primary md:pt-6 md:pb-0',
                  i % 3 > 0 && 'md:pl-8',
                  i % 3 < 2 && 'md:pr-8',
                ]}
              >
                <p class="eyebrow text-muted">
                  <time datetime={post.publishDate.toISOString()}>{postDate.format(post.publishDate)}</time>
                </p>
                <h3 class="mt-3 text-xl leading-snug font-bold text-heading">
                  <a
                    href={getPermalink(post.permalink, 'post')}
                    class="underline-offset-4 hover:text-link hover:underline"
                  >
                    {post.title}
                  </a>
                </h3>
                {post.excerpt && <p class="mt-2 text-muted">{post.excerpt}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Upcoming events -->
  <section class="py-16 md:py-20" aria-labelledby="upcoming">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead id="upcoming" eyebrow="What’s next" title="Upcoming events" />
      {
        upcoming.length ? (
          <ul class="mt-8 grid gap-4">
            {upcoming.map((event) => (
              <li>
                <EventCard event={event} />
              </li>
            ))}
          </ul>
        ) : (
          <div class="mt-8 flex flex-col gap-4 rounded-[4px] border border-dashed border-line bg-mist p-8 md:flex-row md:items-center md:justify-between">
            <p class="text-lg text-default">
              No events are scheduled yet. Town halls and workshops will be listed here as they are announced.
            </p>
            <a href={`mailto:${ORG.contacts[0].email}`} class="btn-site-outline shrink-0">
              <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" /> Ask the team
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- Planning milestones [deck: roadmap] -->
  <section class="bg-ink py-16 md:py-24" aria-labelledby="milestones">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="milestones"
        dark
        eyebrow="Planning milestones"
        title="Roadmap to OceanObs’29"
        intro="Key milestones from the 2026 launch to the October 2029 conference in Qingdao, China."
      />
      <div class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
        {
          ROADMAP.map(({ year, items }) => (
            <section aria-labelledby={`year-${year}`}>
              <h3 id={`year-${year}`} class="font-heading text-4xl font-extrabold text-white">
                {year}
              </h3>
              <ol class="mt-6 space-y-4 border-l border-white/15 pl-5">
                {items.map(({ when, text, done }) => (
                  <li class="relative">
                    <span
                      class:list={[
                        'absolute top-1.5 -left-[25px] h-2.5 w-2.5 rounded-full',
                        done ? 'bg-accent' : 'border border-white/40 bg-ink',
                      ]}
                      aria-hidden="true"
                    />
                    <p class="eyebrow text-accent">
                      {when}
                      <span class="sr-only">{done ? ' (completed)' : ' (upcoming)'}</span>
                    </p>
                    <p class:list={['mt-1 text-sm', done ? 'text-on-dark' : 'text-on-dark-muted']}>{text}</p>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>
      <p class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-on-dark-muted">
        <span class="inline-flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-accent" aria-hidden="true"></span> Completed
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full border border-white/40" aria-hidden="true"></span> Upcoming
        </span>
      </p>
    </div>
  </section>

  <!-- Past events, grouped by conference -->
  {
    pastGroups.map(([key, list]) => {
      const conf = CONFERENCES[key];
      const id = `conf-${key.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
      return (
        <section class="bg-mist py-16 md:py-20" aria-labelledby={id}>
          <div class="mx-auto max-w-7xl px-4 lg:px-6">
            <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="eyebrow-bar text-muted">Past events</p>
                <h2 id={id} class="mt-3 text-3xl font-bold tracking-tight text-heading md:text-4xl">
                  {conf?.name ?? key}
                </h2>
                <p class="eyebrow mt-3 text-muted">
                  {[conf?.place, dateSpan(list), list.length > 1 && `${list.length} events`]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
              </div>
              {conf?.programmeUrl && (
                <a
                  href={conf.programmeUrl}
                  class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-link underline-offset-4 hover:underline"
                >
                  Full programme <Icon name="tabler:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
                </a>
              )}
            </div>
            <div class="mt-8">
              <DayFilter events={list} id={id} label={key} />
            </div>
          </div>
        </section>
      );
    })
  }
</Layout>
