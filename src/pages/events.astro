---
// News & Events, reorganized 2026-11-22 per the website update brief: Upcoming events → Past events →
// Selected planning updates, as compact dated rows. Events come from src/data/events (shared with Home);
// planning updates from src/data/roadmap.ts. News posts (src/data/post) appear first once there are any.
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import EventRow from '~/components/site/EventRow.astro';
import UpcomingEvents from '~/components/site/UpcomingEvents.astro';

import { ORG } from '~/config/org';
import { PLANNING_UPDATES } from '~/data/roadmap';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getEvents, splitByTime } from '~/utils/events';

const metadata = {
  title: 'News & Events',
  // [draft]
  description: `Upcoming events where you can discuss ocean observing priorities, past ${ORG.name} events, and selected planning updates.`,
};

const posts = await findLatestPosts({ count: 6 });
const postDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const { upcoming, past } = splitByTime(await getEvents());
---

<Layout metadata={metadata}>
  <PageHeader
    eyebrow="News & Events"
    title="News & Events"
    intro="Upcoming events where you can discuss observing priorities, past OceanObs’29 events, and selected planning updates."
  />

  <!-- News -->
  {
    posts.length > 0 && (
      <section class="py-16 md:py-20" aria-labelledby="news">
        <div class="mx-auto max-w-7xl px-4 lg:px-6">
          <SectionHead id="news" eyebrow="News" title="Announcements" />
          <ul class="mt-10 grid border-t border-line md:grid-cols-3 md:border-t-0">
            {posts.map((post, i) => (
              <li
                class:list={[
                  'border-b border-line py-6 md:border-t-4 md:border-b-0 md:border-t-primary md:pt-6 md:pb-0',
                  i % 3 > 0 && 'md:pl-8',
                  i % 3 < 2 && 'md:pr-8',
                ]}
              >
                <p class="eyebrow text-muted">
                  <time datetime={post.publishDate.toISOString()}>{postDate.format(post.publishDate)}</time>
                </p>
                <h3 class="mt-3 text-xl leading-snug font-bold text-heading">
                  <a
                    href={getPermalink(post.permalink, 'post')}
                    class="underline-offset-4 hover:text-link hover:underline"
                  >
                    {post.title}
                  </a>
                </h3>
                {post.excerpt && <p class="mt-2 text-muted">{post.excerpt}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Upcoming events -->
  <section class="py-16 md:py-20" aria-labelledby="upcoming">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead id="upcoming" eyebrow="What’s next" title="Upcoming events" />
      <div class="mt-8">
        <UpcomingEvents events={upcoming} />
      </div>
    </div>
  </section>

  <!-- Past events -->
  {
    past.length > 0 && (
      <section class="bg-mist py-16 md:py-20" aria-labelledby="past">
        <div class="mx-auto max-w-7xl px-4 lg:px-6">
          <SectionHead id="past" eyebrow="Archive" title="Past events" />
          <ul class="mt-8 border-b border-line">
            {past.map((event) => (
              <li>
                <EventRow event={event} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Selected planning updates (keeps the #milestones anchor) -->
  {
    PLANNING_UPDATES.length > 0 && (
      <section class="py-16 md:py-20" aria-labelledby="milestones">
        <div class="mx-auto max-w-7xl px-4 lg:px-6">
          <SectionHead id="milestones" eyebrow="Planning" title="Selected planning updates" />
          <ol class="mt-8 max-w-4xl border-b border-line">
            {PLANNING_UPDATES.map(({ when, text, link }) => (
              <li class="grid gap-x-8 gap-y-1 border-t border-line py-5 md:grid-cols-[11rem_1fr]">
                <p class="font-heading font-extrabold text-heading">{when}</p>
                <p class="text-default">
                  {text}
                  {link && (
                    <>
                      {' '}
                      <a
                        href={
                          getPermalink(link.href.split('#')[0]) +
                          (link.href.includes('#') ? `#${link.href.split('#')[1]}` : '')
                        }
                        class="inline-flex items-center gap-1 font-semibold text-link underline-offset-4 hover:underline"
                      >
                        {link.text} <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
                      </a>
                    </>
                  )}
                </p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }
</Layout>
