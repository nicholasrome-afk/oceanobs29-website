---
// Publications & Resources. Rewritten 2026-11-22 per the website update brief, then revised the same day at
// the project lead's request: the Program Committee workshop summary first, then the OceanObs’19
// publications and outcomes. The "Examples from the white papers" list and the "OceanObs’29 publication
// updates" note were removed. Copy: [brief] unless marked [draft] (written by Claude for review).
// Links checked 2026-11-22.
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import SectionHead from '~/components/site/SectionHead.astro';

import { WORKSHOP_SUMMARY } from '~/config/images';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Publications & Resources',
  // [draft]
  description:
    'Read the OceanObs’29 Program Committee workshop summary, and OceanObs’19 community white papers, synthesis, and conference statements.',
};

const CWP_ARCHIVE = 'https://oceanobs19.net/outcomes/community-white-papers';

const core = [
  {
    title: 'OceanObs’19 Community White Papers',
    text: 'Browse the published community recommendations on observing priorities, integration, and the needs of people who use ocean data.',
    link: { text: 'Browse the white papers', href: CWP_ARCHIVE },
  },
  {
    title: 'OceanObs’19 synthesis',
    // The archive's direct "CWP Synthesis" link (a Google Doc) returned "Page Not Found" signed out on
    // 2026-11-22, so this points to the archive page and says where to look (brief's fallback).
    text: 'See the Program Committee’s summary of the needs and recommendations raised by white paper authors. On the archive page, look under “Synthesis.”',
    link: { text: 'White papers and synthesis archive', href: CWP_ARCHIVE },
  },
  {
    title: 'OceanObs’19 Conference Statement',
    text: 'Read the conference’s shared priorities for sustained ocean observations and the use of ocean information.',
    link: {
      text: 'Read the conference statement (PDF)',
      href: 'https://oceanobs19.net/sites/default/files/2023-03/OO19-Conference-Statement_online.pdf',
    },
  },
  {
    title: 'Aha Honua declaration',
    text: 'Read the Coastal Indigenous Peoples’ Declaration shared at OceanObs’19.',
    link: {
      text: 'Conference statements archive',
      href: 'https://oceanobs19.net/conference-archive/conference-statements',
    },
  },
];

const linkClass = 'inline-flex items-center gap-1.5 font-semibold text-link underline-offset-4 hover:underline';
---

<Layout metadata={metadata}>
  <PageHeader
    title="Publications & Resources"
    intro="Read the summary of the first OceanObs’29 Program Committee workshop, and the community white papers, synthesis, and conference statements from OceanObs’19."
  />

  <!--
    Program Committee workshop summary. Facts from the report itself (Hong Kong, May 2026, alongside the
    Global Ocean Summit 2026). PDF supplied by the project lead for publication (2026-11-22).
  -->
  <section class="py-16 md:py-20" aria-labelledby="planning-resources">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead id="planning-resources" title="OceanObs’29 planning resources" />
      <article class="mt-8 grid max-w-4xl gap-6 border-t border-line pt-8 sm:grid-cols-[10rem_1fr] sm:gap-8">
        <a href={getPermalink(WORKSHOP_SUMMARY.href)} class="block self-start" tabindex="-1" aria-hidden="true">
          <Image
            src={WORKSHOP_SUMMARY.cover}
            alt=""
            width={320}
            class="w-32 rounded-[3px] border border-line shadow-sm sm:w-40"
          />
        </a>
        <div>
          <p class="eyebrow text-xs text-link">Workshop summary · Hong Kong · May 2026</p>
          <h3 class="mt-2 text-xl font-bold text-heading md:text-2xl">
            First Assembly Meeting of the OceanObs’29 Program Committee
          </h3>
          <p class="mt-3 text-default">
            Read the summary of the first Program Committee workshop, held jointly with the International Advisory
            Committee alongside the Global Ocean Summit 2026, and the planning topics discussed.
          </p>
          <a href={getPermalink(WORKSHOP_SUMMARY.href)} class:list={[linkClass, 'mt-4']}>
            <Icon name="tabler:file-type-pdf" class="h-5 w-5 shrink-0" aria-hidden="true" />
            Read the workshop summary (PDF, 12 pages, 2.8 MB)
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- OceanObs’19 publications and outcomes [brief] -->
  <section class="bg-mist py-16 md:py-20" aria-labelledby="archives">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead id="archives" title="OceanObs’19 publications and outcomes" />
      <ul class="mt-8 max-w-4xl border-b border-line">
        {
          core.map(({ title, text, link }) => (
            <li class="grid gap-x-8 gap-y-2 border-t border-line py-6 md:grid-cols-[1fr_auto]">
              <div>
                <h3 class="text-xl font-bold text-heading">{title}</h3>
                <p class="mt-2 text-default">{text}</p>
              </div>
              <a href={link.href} class:list={[linkClass, 'self-start md:pt-1']}>
                {link.text} <Icon name="tabler:arrow-up-right" class="h-4 w-4 shrink-0" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
