---
// Get Involved, rewritten 2026-11-22 per the website update brief: open routes first (email, events), the
// paper route marked Pending, and a short participation statement (the "Who should take part?" section was
// removed the same day at the project lead's request).
// Draft schedules, proposed councils, schemes, networks and travel/visa/language support were removed until
// a public mechanism is agreed. Copy: [brief] unless marked [draft] (written by Claude for review).
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import SectionHead from '~/components/site/SectionHead.astro';

import { ORG } from '~/config/org';
import { getPermalink } from '~/utils/permalinks';

const email = ORG.contacts[0].email;

const metadata = {
  title: 'Get Involved',
  // [draft]
  description:
    'Share where better ocean observations would make a difference, find community events, and see how to take part in OceanObs’29 before the conference.',
};

const linkClass = 'font-semibold text-link underline underline-offset-4 hover:no-underline';
---

<Layout metadata={metadata}>
  <PageHeader
    title="Get involved"
    intro="Help identify where better ocean observations would make a difference. You can contribute before the conference, wherever you are based."
  />

  <!-- Where to start [brief]. #ways is the main entry point; #input (old anchor) lands on the email invitation. -->
  <section class="py-16 md:py-24" aria-labelledby="ways">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead id="ways" title="Where to start" />
      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        <li id="input" class="flex scroll-mt-28 flex-col rounded-[4px] border-t-4 border-primary bg-mist p-6 md:p-8">
          <Icon name="tabler:mail" class="h-8 w-8 text-primary" aria-hidden="true" />
          <h3 class="mt-5 text-xl font-bold text-heading">Share your perspective</h3>
          <p class="mt-3 text-default">
            What observation is missing, where is it needed, and what decision would better data improve? Send your
            perspective to the OceanObs’29 Coordination Team at {email}.
          </p>
          <a href={`mailto:${email}`} class="btn-site-primary mt-6 self-start md:mt-auto">
            <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" /> Email {email}
          </a>
        </li>
        <li class="flex flex-col rounded-[4px] border-t-4 border-primary bg-mist p-6 md:p-8">
          <Icon name="tabler:microphone-2" class="h-8 w-8 text-primary" aria-hidden="true" />
          <h3 class="mt-5 text-xl font-bold text-heading">Join a community event</h3>
          <p class="mt-3 text-default">
            Find announced town halls and other opportunities to discuss observing priorities.
          </p>
          <a
            href={`${getPermalink('/events')}#upcoming`}
            class="mt-6 inline-flex items-center gap-1.5 self-start font-semibold text-link underline-offset-4 hover:underline md:mt-auto"
          >
            Upcoming events <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </li>
        <li class="flex flex-col rounded-[4px] border-t-4 border-line bg-white p-6 ring-1 ring-line ring-inset md:p-8">
          <Icon name="tabler:file-text" class="h-8 w-8 text-muted" aria-hidden="true" />
          <h3 class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-xl font-bold text-heading">
            Contribute to a topical paper
            <span class="eyebrow rounded-[3px] border border-line bg-mist px-2 py-1 text-xs text-muted">Pending</span>
          </h3>
          <p class="mt-3 text-default">The OceanObs’29 publications process is still being developed.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Participation and access [brief] -->
  <section class="bg-mist py-16 md:py-20" aria-labelledby="inclusion">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 lg:grid-cols-12 lg:px-6">
      <div class="lg:col-span-5">
        <h2 id="inclusion" class="scroll-mt-28 text-3xl font-bold tracking-tight text-heading md:text-4xl">
          Participation and access
        </h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-lg text-default">
          OceanObs’29 welcomes input from across regions and career stages, including people who face travel, cost, or
          language barriers. The <a class={linkClass} href={`${getPermalink('/about')}#ecop-committee`}
            >Early Career Ocean Professionals Committee</a
          > brings early career perspectives into planning. Share any participation barriers or suggestions with the <a
            class={linkClass}
            href={`mailto:${email}`}>Coordination Team</a
          >.
        </p>
        <p class="mt-6 text-muted">
          Context: the <a class={linkClass} href="https://oceanobs19.net/conference-archive/conference-statements"
            >Aha Honua Coastal Indigenous Peoples’ Declaration</a
          >, shared at OceanObs’19.
        </p>
      </div>
    </div>
  </section>
</Layout>
