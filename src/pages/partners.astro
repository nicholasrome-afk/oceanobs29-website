---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import NetworkCard from '~/components/site/NetworkCard.astro';
import PartnershipFinder from '~/components/site/PartnershipFinder.astro';

import { IMAGES } from '~/config/images';
import { fundingContact, opportunities } from '~/config/partnerships';

const metadata = {
  title: 'Partner with OceanObs’29',
  description:
    'Help shape ocean observing through 2040. Support scientific synthesis, global participation and practical uses of ocean data in 2027.',
};

const partners = await getCollection('network');
const supportOptions = [
  { icon: 'tabler:files', ...opportunities.papers },
  { icon: 'tabler:world', ...opportunities.participation },
  { icon: 'tabler:chart-line', ...opportunities.applications },
];
---

<Layout metadata={metadata}>
  <PageHeader
    eyebrow="Partner with OceanObs’29"
    title="Help shape ocean observing through 2040"
    intro="Ocean observations help communities anticipate coastal flooding, improve forecasts and understand how the ocean is changing. OceanObs’29 builds on the UN Ocean Decade’s progress to set priorities for the next decade of ocean observing."
    image={IMAGES.homeHero}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={fundingContact.href} class="btn-site-accent">
        <Icon name="tabler:mail" class="size-4" aria-hidden="true" />
        {fundingContact.label}
      </a>
      <a href="#support-in-2027" class="btn-site-outline-light">
        Explore the 2027 work
        <Icon name="tabler:arrow-down" class="size-4" aria-hidden="true" />
      </a>
    </div>
  </PageHeader>

  <section id="support-in-2027" class="scroll-mt-24 py-16 md:py-24" aria-labelledby="why">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <h2 id="why" class="scroll-mt-24 text-3xl font-bold tracking-tight text-heading md:text-4xl">
        What your support makes possible in 2027
      </h2>
      <p class="mt-4 max-w-3xl text-lg text-muted">
        With partner support, the first phase will bring observing teams, scientists and data users together to identify
        gaps and develop questions for the OceanObs’29 community papers. One question they could tackle is where better
        measurements or faster data sharing would make the biggest difference for coastal flood forecasts.
      </p>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        {
          supportOptions.map(({ icon, title, description }) => (
            <li class="rounded-sm border border-line bg-page p-6 md:p-8">
              <Icon name={icon} class="size-8 text-primary" aria-hidden="true" />
              <h3 class="mt-5 text-xl font-bold text-heading">{title}</h3>
              <p class="mt-3 text-muted">{description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-mist py-14 md:py-20" aria-labelledby="track-record">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 md:grid-cols-2 md:gap-16 lg:px-6">
      <div>
        <h2 id="track-record" class="text-2xl font-bold tracking-tight text-heading md:text-3xl">
          What OceanObs’19 produced
        </h2>
        <p class="mt-4 text-lg text-default">
          OceanObs’19 brought together about 1,500 participants. Its 128 community white papers informed a synthesis of
          priorities for ocean observing.
        </p>
        <a
          href="https://oceanobs19.net/outcomes/community-white-papers"
          class="mt-5 inline-flex items-center gap-2 font-semibold text-link underline-offset-4 hover:underline"
        >
          Read the community papers and synthesis
          <Icon name="tabler:arrow-up-right" class="size-4 shrink-0" aria-hidden="true" />
        </a>
      </div>
      <div class="border-t border-line pt-8 md:border-t-0 md:border-l md:pt-0 md:pl-8 lg:pl-12">
        <h2 id="integrity" class="scroll-mt-24 text-2xl font-bold tracking-tight text-heading md:text-3xl">
          Scientific direction stays with the community
        </h2>
        <p class="mt-4 text-lg text-default">
          The Program Committee leads scientific priorities, program decisions and publications. Partners support the
          work. The Sponsors Committee, forming in early 2027, will guide fundraising and partner relationships.
        </p>
      </div>
    </div>
  </section>

  {
    partners.length > 0 && (
      <section class="py-16 md:py-24" aria-labelledby="our-partners">
        <div class="mx-auto max-w-7xl px-4 lg:px-6">
          <SectionHead id="our-partners" eyebrow="Partners" title="Our partners" />
          <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {partners.map((item) => (
              <li>
                <NetworkCard item={item} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <PartnershipFinder />

  <section class="bg-mist py-16 md:py-20" aria-labelledby="contact-partnerships">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 md:flex-row md:items-center md:justify-between lg:px-6">
      <div class="max-w-2xl">
        <h2 id="contact-partnerships" class="text-3xl font-bold tracking-tight text-heading md:text-4xl">
          Start a funding conversation
        </h2>
        <p class="mt-4 text-lg text-muted">
          Tell the OceanObs’29 Coordination Team which part of the work interests you. We’ll follow up to discuss the
          scope, what your support could make possible and how we’d report progress.
        </p>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-2 md:items-end">
        <a href={fundingContact.href} class="btn-site-primary">
          <Icon name="tabler:mail" class="size-4" aria-hidden="true" />
          {fundingContact.label}
        </a>
        <p class="text-sm text-muted">{fundingContact.email}</p>
      </div>
    </div>
  </section>
</Layout>
