---
// About: vision, objectives, decadal legacy, governance and committees.
// Words marked [old site] are copied from oceanobs29.net; [draft] were
// written for review. Committee lists live in src/data/committees.ts.
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import PersonCard from '~/components/site/PersonCard.astro';
import PhotoCredit from '~/components/site/PhotoCredit.astro';

import { ORG } from '~/config/org';
import { HOME } from '~/config/home';
import { IMAGES } from '~/config/images';
import { ADVISORY_COMMITTEE, PROGRAM_COMMITTEE, COORDINATION_TEAM } from '~/data/committees';

const metadata = {
  title: 'About',
  description:
    'OceanObs’29 is the next in a series of international decadal conferences that guide the evolution of sustained, integrated ocean observing systems.',
};

// [old site: Process page] Committee roles. `status` [deck: Planning update, Oct 2026, slide 3].
const structure = [
  {
    name: 'International Advisory Committee',
    href: '#advisory-committee',
    text: 'Provides high-level strategic guidance, keeping the conference vision aligned with global priorities in ocean observing and reflecting diverse geographic, disciplinary, and sectoral perspectives.',
  },
  {
    name: 'Coordination Team',
    href: '#coordination-team',
    text: 'Integrates OceanObs’29 activities, supporting communication, alignment, and information flow among the committees, and consistency with the conference vision, timeline, and agreed processes.',
  },
  {
    name: 'Program Committee',
    href: '#program-committee',
    text: 'Leads the intellectual development of OceanObs’29: shaping themes, guiding engagement activities, and overseeing synthesis leading up to the conference.',
  },
  {
    name: 'Early Career Ocean Professionals (ECOP) Committee',
    status: 'Active · 2026',
    text: 'Supports engagement of early career ocean professionals across OceanObs’29, working with the Program Committee to integrate their perspectives into planning, participation, and outcomes.',
  },
  {
    name: 'Sponsors Committee',
    status: 'Forming · early 2027',
    text: 'Coordinates engagement with sponsors and partners, aligning sponsor interests with the OceanObs’29 mission while maintaining the scientific integrity and independence of the program.',
  },
  {
    name: 'Local Organizing Committee',
    status: 'Planned · first half of 2028',
    text: 'Supports venue-specific planning and logistics, coordinating with local partners and service providers for effective on-site delivery.',
  },
];

// [deck: slide 3] The Program Committee's six working groups.
const workingGroups = [
  'Program Architecture',
  'Community Publications',
  'Communications',
  'Strategic Partners & Resources',
  'Indigenous & Under-represented Groups',
  'ECOP Engagement',
];
---

<Layout metadata={metadata}>
  <PageHeader
    eyebrow="About"
    title="What is OceanObs’29?"
    intro="A decadal forum bringing together the global ocean community to define priorities, strengthen coordination, and ensure ocean observing remains scientifically robust, societally relevant, and fit for the future."
  >
    <nav class="mt-10" aria-label="On this page">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-on-dark-link">
        <li><a class="hover:underline" href="#vision">Vision</a></li>
        <li><a class="hover:underline" href="#legacy">Decadal legacy</a></li>
        <li><a class="hover:underline" href="#governance">Governance</a></li>
        <li><a class="hover:underline" href="#advisory-committee">Advisory Committee</a></li>
        <li><a class="hover:underline" href="#program-committee">Program Committee</a></li>
        <li><a class="hover:underline" href="#coordination-team">Coordination Team</a></li>
      </ul>
    </nav>
  </PageHeader>

  <!-- Vision and objectives [old site] -->
  <section class="py-16 md:py-24" aria-labelledby="vision">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 lg:grid-cols-12 lg:px-6">
      <div class="lg:col-span-7">
        <p class="eyebrow-bar text-muted">Vision</p>
        <h2 id="vision" class="mt-3 scroll-mt-28 text-3xl font-bold tracking-tight text-heading md:text-4xl">
          Observations that underpin how we understand and manage the ocean
        </h2>
        <p class="mt-6 text-lg text-default">
          Ocean observations underpin research, operational services, and decision-making related to weather, climate,
          marine resources, hazards, and environmental change. OceanObs’29 provides a structured forum to assess
          progress, identify gaps, and chart a coordinated path forward.
        </p>
        <h3 class="mt-12 text-xl font-bold text-heading">Objectives</h3>
        <p class="mt-2 text-muted">OceanObs’29 will:</p>
        <ol class="mt-6 grid gap-px bg-line sm:grid-cols-2">
          {
            HOME.future.cards.map(({ icon, title, text }) => (
              <li class="bg-white p-5 pl-0 sm:pr-6 sm:even:pl-6">
                <Icon name={icon} class="h-7 w-7 text-primary" aria-hidden="true" />
                <p class="mt-3 font-bold text-heading">{title}</p>
                <p class="mt-1 text-muted">{text}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <figure class="relative self-start lg:col-span-5">
        <Image
          src={IMAGES.aboutFeature.src}
          alt={IMAGES.aboutFeature.alt}
          layout="none"
          widths={[480, 960]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="aspect-[4/5] w-full rounded-[4px] object-cover"
        />
        <PhotoCredit image={IMAGES.aboutFeature} />
      </figure>
    </div>
  </section>

  <!-- Decadal legacy [deck: slide 2] -->
  <section class="bg-ink py-16 md:py-24" aria-labelledby="legacy">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="legacy"
        dark
        eyebrow="Decadal legacy"
        title="Part of a series that has guided ocean observing since 1999"
        intro="OceanObs’29 is the next in a series of international decadal conferences that guide the evolution of sustained, integrated ocean observing systems. Building on the legacy of OceanObs’99, ’09, and ’19, it will focus on aligning scientific ambition, technological innovation, and user needs across the global ocean observing enterprise."
      />
      <ol class="mt-12 grid grid-cols-2 gap-px bg-white/10 md:grid-cols-4">
        {
          HOME.vision.series.map(({ name, place, size, legacy, url, current }) => (
            <li class:list={['flex flex-col p-6 md:p-8', current ? 'bg-ink-raised' : 'bg-ink']}>
              <p
                class:list={[
                  'font-heading text-4xl font-extrabold md:text-5xl',
                  current ? 'text-accent' : 'text-white/80',
                ]}
              >
                {name.replace('OceanObs', '')}
              </p>
              <p class="mt-2 font-semibold text-on-dark">{name}</p>
              <p class="text-sm text-on-dark-muted">
                {place} · {size}
              </p>
              <p class="mt-4 text-sm text-on-dark">{legacy}</p>
              {url && (
                <a
                  href={url}
                  class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-on-dark-link hover:underline"
                >
                  {name} website <Icon name="tabler:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Governance [old site: Process page] -->
  <section class="py-16 md:py-24" aria-labelledby="governance">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="governance"
        eyebrow="Governance"
        title="How OceanObs’29 is organized"
        intro="OceanObs’29 is guided by a lightweight governance structure designed to support coordination, transparency, and broad community engagement throughout the planning and delivery of the conference. The structure balances strategic guidance, program development, sponsorship coordination, and local logistics, while maintaining flexibility as priorities evolve."
      />
      <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          structure.map(({ name, text, status, href }) => (
            <li class="flex flex-col rounded-[4px] border border-line p-6">
              <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
                <h3 class="text-lg leading-snug font-bold text-heading">
                  {href ? (
                    <a href={href} class="underline-offset-4 hover:text-link hover:underline">
                      {name}
                    </a>
                  ) : (
                    name
                  )}
                </h3>
                {status && <span class="eyebrow rounded-[3px] bg-mist px-2 py-1 text-xs text-muted">{status}</span>}
              </div>
              <p class="mt-3 text-muted">{text}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 rounded-[4px] bg-mist p-6 md:p-8">
        <h3 class="text-lg font-bold text-heading">Working groups</h3>
        <p class="mt-2 text-muted">The Program Committee launched six working groups in May 2026.</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            workingGroups.map((group) => (
              <li class="rounded-[3px] border border-line bg-white px-3 py-1.5 text-sm font-semibold text-heading">
                {group}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- International Advisory Committee [old site: description; list from committees-review.md] -->
  <section class="bg-mist py-16 md:py-24" aria-labelledby="advisory-committee">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="advisory-committee"
        eyebrow="Committee"
        title="International Advisory Committee"
        intro="The International Advisory Committee offers perspective on the conference vision, emerging priorities, and alignment with global ocean observing efforts, while maintaining a broad, international view of scientific, operational, and societal needs. It is consulted on major strategic matters and meets on request, focusing on strategic reflection, guidance, and alignment rather than operational decisions."
      />
      <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
        {
          ADVISORY_COMMITTEE.map((person) => (
            <li>
              <PersonCard person={person} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Program Committee [old site: description; list from committees-review.md] -->
  <section class="py-16 md:py-24" aria-labelledby="program-committee">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="program-committee"
        eyebrow="Committee"
        title="Program Committee"
        intro="The Program Committee provides scientific and strategic leadership for the conference, shaping its vision, defining scientific priorities and themes, and guiding community engagement so that OceanObs’29 reflects global diversity, scientific excellence, and long-term relevance. Early Career Ocean Professional participation is integrated throughout."
      />
      <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
        {
          PROGRAM_COMMITTEE.map((person) => (
            <li>
              <PersonCard person={person} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Coordination team and contact [old site: FAQ] -->
  <section class="bg-ink py-16 md:py-20" aria-labelledby="coordination-team">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 md:flex-row md:items-end md:justify-between lg:px-6">
      <div class="max-w-2xl">
        <p class="eyebrow-bar text-on-dark-muted before:bg-accent">Governance</p>
        <h2 id="coordination-team" class="mt-3 scroll-mt-28 text-3xl font-bold tracking-tight text-white md:text-4xl">
          Coordination Team
        </h2>
        <p class="mt-4 text-xl text-on-dark">
          {COORDINATION_TEAM.slice(0, -1).join(', ')} and {COORDINATION_TEAM.at(-1)}
        </p>
        <p class="mt-2 text-lg text-on-dark-muted">
          Questions sent to {ORG.contacts[0].email} are routed to the OceanObs’29 Coordination Team.
        </p>
      </div>
      <a href={`mailto:${ORG.contacts[0].email}`} class="btn-site-accent shrink-0">
        <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" />
        {ORG.contacts[0].email}
      </a>
    </div>
  </section>
</Layout>
