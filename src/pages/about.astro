---
// About, reorganized 2026-11-22 per the website update brief: About OceanObs’29 → OceanObs’29 and the UN
// Ocean Decade → How OceanObs’29 is organized → committees and Coordination Team. The OOI photo, the
// objectives grid, the series history (now /conference#series), the working-group inventory and draft
// committee schedules were removed. Words: [old site] oceanobs29.net; [brief] the update brief;
// [draft] written by Claude for review. Committee lists live in src/data/committees.ts.
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import PersonCard from '~/components/site/PersonCard.astro';

import { ORG } from '~/config/org';
import { getPermalink } from '~/utils/permalinks';
import { ADVISORY_COMMITTEE, PROGRAM_COMMITTEE, COORDINATION_TEAM } from '~/data/committees';

const metadata = {
  title: 'About',
  // [brief: About introduction]
  description:
    'OceanObs’29 brings together people who collect ocean observations and people who use them to review progress and identify priorities for the next decade.',
};

// [old site: Process page] Roles of the bodies with a verified public role, in the order of the brief's summary.
// The Sponsors Committee and Local Organizing Committee (draft schedules) are left out until they are in place.
const structure = [
  {
    name: 'Program Committee',
    href: '#program-committee',
    text: 'Leads the intellectual development of OceanObs’29: shaping themes, guiding engagement activities, and overseeing synthesis leading up to the conference.',
  },
  {
    name: 'International Advisory Committee',
    href: '#advisory-committee',
    text: 'Provides high-level strategic guidance, keeping the conference vision aligned with global priorities in ocean observing and reflecting diverse geographic, disciplinary, and sectoral perspectives.',
  },
  {
    name: 'Early Career Ocean Professionals (ECOP) Committee',
    href: '#ecop-committee',
    // [ECOP minutes, 29 Oct 2026] Four co-chairs; members in Africa, the Americas, Asia and Europe.
    // Names are held until the co-chairs agree to be listed.
    text: 'Brings early career ocean professionals into OceanObs’29 planning, participation, and outcomes. Its four Co-Chairs link it directly to the Program Committee, and its members work across Africa, the Americas, Asia, and Europe.',
  },
  {
    name: 'Coordination Team',
    href: '#coordination-team',
    text: 'Integrates OceanObs’29 activities, supporting communication, alignment, and information flow among the committees. It is the point of contact for questions and participation.',
  },
] as { name: string; text: string; href?: string; id?: string }[];

const email = ORG.contacts[0].email;
const linkClass = 'font-semibold text-link underline underline-offset-4 hover:no-underline';
---

<Layout metadata={metadata}>
  <PageHeader
    eyebrow="About"
    title="About OceanObs’29"
    intro="OceanObs’29 is part of the international conference series on sustained ocean observing. It brings together people who collect observations and people who use them to review progress and identify priorities for the next decade."
  >
    <p class="mt-6 max-w-2xl text-on-dark">
      Questions? Contact the Coordination Team at <a
        class="font-semibold text-on-dark-link underline underline-offset-4 hover:no-underline"
        href={`mailto:${email}`}>{email}</a
      >.
    </p>
    <nav class="mt-10" aria-label="On this page">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-on-dark-link">
        <li><a class="hover:underline" href="#ocean-decade">UN Ocean Decade</a></li>
        <li><a class="hover:underline" href="#governance">How it’s organized</a></li>
        <li><a class="hover:underline" href="#program-committee">Program Committee</a></li>
        <li><a class="hover:underline" href="#ecop-committee">ECOP Committee</a></li>
        <li><a class="hover:underline" href="#advisory-committee">Advisory Committee</a></li>
        <li><a class="hover:underline" href="#coordination-team">Coordination Team</a></li>
      </ul>
    </nav>
  </PageHeader>

  <!--
    OceanObs’29 and the UN Ocean Decade [brief]. Thematic link only (UNESCO-IOC Challenge 7 materials).
    PENDING (endorsement): once the exact endorsed entity and approved wording are confirmed in organizer
    materials, add the endorsement sentence, a link to the official record and the authorized mark here,
    following the Ocean Decade logo terms (https://oceandecade.org/legal/). Keep the mark away from partner
    lists, funding asks and external event entries. Keeps the old #vision anchor.
  -->
  <section id="vision" class="scroll-mt-28 py-16 md:py-20" aria-labelledby="ocean-decade">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 lg:grid-cols-12 lg:px-6">
      <div class="lg:col-span-5">
        <p class="eyebrow-bar text-muted">UN Ocean Decade</p>
        <h2 id="ocean-decade" class="mt-3 scroll-mt-28 text-3xl font-bold tracking-tight text-heading md:text-4xl">
          OceanObs’29 and the UN Ocean Decade
        </h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-lg text-default">
          The UN Decade of Ocean Science for Sustainable Development calls for sustained ocean observing across all
          ocean basins. OceanObs’29 builds on discussion from OceanObs’19 about how to close observing gaps and make
          data more useful to the people who rely on it. <a
            class={linkClass}
            href="https://oceandecade.org/news/vision-2030-wg7-to-sustainably-expand-the-global-ocean-observing-system/"
            >Ocean Decade Challenge 7</a
          >
        </p>
        <p class="mt-6 text-muted">
          OceanObs’29 continues a conference series that began in 1999. <a
            class={linkClass}
            href={`${getPermalink('/conference')}#series`}>About the OceanObs conference series</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- How OceanObs’29 is organized [brief summary; card text: old site] -->
  <section class="bg-mist py-16 md:py-20" aria-labelledby="governance">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="governance"
        eyebrow="Governance"
        title="How OceanObs’29 is organized"
        intro="The Program Committee leads scientific and program planning. The International Advisory Committee provides strategic guidance, the Early Career Ocean Professionals Committee brings early career perspectives into the process, and the Coordination Team is the point of contact for questions and participation."
      />
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {
          structure.map(({ name, text, href, id }) => (
            <li id={id} class="flex scroll-mt-28 flex-col rounded-[4px] bg-white p-6">
              <h3 class="text-lg leading-snug font-bold text-heading">
                {href ? (
                  <a href={href} class="underline-offset-4 hover:text-link hover:underline">
                    {name}
                  </a>
                ) : (
                  name
                )}
              </h3>
              <p class="mt-3 text-muted">{text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Program Committee [old site: description; list from committees-review.md] -->
  <section class="py-16 md:py-24" aria-labelledby="program-committee">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="program-committee"
        eyebrow="Committee"
        title="Program Committee"
        intro="The Program Committee provides scientific and strategic leadership for the conference, shaping its vision, defining scientific priorities and themes, and guiding community engagement so that OceanObs’29 reflects global diversity, scientific excellence, and long-term relevance. Early Career Ocean Professional participation is integrated throughout."
      />
      <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
        {
          PROGRAM_COMMITTEE.map((person) => (
            <li>
              <PersonCard person={person} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!--
    ECOP Committee (added 2026-11-22 at the project lead's request). Facts from the ECOP Committee minutes
    (29 Oct 2026) and the planning roadmap (established Aug 2026). Stage 1 of the agreed plan: no names until the
    four Co-Chairs agree to be listed; then the full list after announcement, with consent.
  -->
  <section class="bg-mist py-16 md:py-24" aria-labelledby="ecop-committee">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="ecop-committee"
        eyebrow="Committee"
        title="Early Career Ocean Professionals Committee"
        intro="The Early Career Ocean Professionals (ECOP) Committee brings early career ocean professionals into OceanObs’29 planning, participation, and outcomes."
      />
      <dl class="mt-10 grid max-w-5xl gap-px bg-line sm:grid-cols-3">
        <div class="bg-white p-6">
          <dt class="eyebrow text-xs text-muted">Established</dt>
          <dd class="mt-2 text-lg text-default">2026</dd>
        </div>
        <div class="bg-white p-6">
          <dt class="eyebrow text-xs text-muted">Leadership</dt>
          <dd class="mt-2 text-lg text-default">
            Four Co-Chairs, who link the committee directly to the Program Committee
          </dd>
        </div>
        <div class="bg-white p-6">
          <dt class="eyebrow text-xs text-muted">Members</dt>
          <dd class="mt-2 text-lg text-default">
            Early career ocean professionals across Africa, the Americas, Asia, and Europe
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- International Advisory Committee [old site: description; list from committees-review.md] -->
  <section class="py-16 md:py-24" aria-labelledby="advisory-committee">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="advisory-committee"
        eyebrow="Committee"
        title="International Advisory Committee"
        intro="The International Advisory Committee offers perspective on the conference vision, emerging priorities, and alignment with global ocean observing efforts, while maintaining a broad, international view of scientific, operational, and societal needs. It is consulted on major strategic matters and meets on request, focusing on strategic reflection, guidance, and alignment rather than operational decisions."
      />
      <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
        {
          ADVISORY_COMMITTEE.map((person) => (
            <li>
              <PersonCard person={person} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Coordination team and contact [old site: FAQ] -->
  <section class="bg-ink py-16 md:py-20" aria-labelledby="coordination-team">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 md:flex-row md:items-end md:justify-between lg:px-6">
      <div class="max-w-2xl">
        <p class="eyebrow-bar text-on-dark-muted before:bg-accent">Governance</p>
        <h2 id="coordination-team" class="mt-3 scroll-mt-28 text-3xl font-bold tracking-tight text-white md:text-4xl">
          Coordination Team
        </h2>
        <p class="mt-4 text-xl text-on-dark">
          {COORDINATION_TEAM.slice(0, -1).join(', ')}{COORDINATION_TEAM.length > 2 ? ',' : ''} and {
            COORDINATION_TEAM.at(-1)
          }
        </p>
        <p class="mt-2 text-lg text-on-dark-muted">
          Questions sent to {ORG.contacts[0].email} are routed to the OceanObs’29 Coordination Team.
        </p>
      </div>
      <a href={`mailto:${ORG.contacts[0].email}`} class="btn-site-accent shrink-0">
        <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" />
        {ORG.contacts[0].email}
      </a>
    </div>
  </section>
</Layout>
