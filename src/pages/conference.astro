---
// The Conference, rewritten 2026-11-22 per the website update brief (the logistics section was then removed
// the same day at the project lead's request, and Qingdao, China, was added back to the intro): what the conference is, how to take
// part before it, the logistics status (Qingdao named once, no unconfirmed month, attendance estimate or
// committee deadline), and the series history moved here from About and Resources. On 2026-11-23 the series
// section was replaced by "What a global conference makes possible" (moved from the homepage).
// Copy: [brief] the website update brief, which cites dco-oo.org/events for the Glasgow town hall and the
// OceanObs’19 editorial (Frontiers in Marine Science, 2019, doi:10.3389/fmars.2019.00570) for the series.
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'The Conference',
  description: 'About the OceanObs’29 conference, its planning status, and ways to contribute before the meeting.',
};

const linkClass = 'font-semibold text-link underline underline-offset-4 hover:no-underline';
const cardLinkClass = 'inline-flex items-center gap-1.5 font-semibold text-link underline-offset-4 hover:underline';

// [lead] OceanObs’99, ’09, and ’19, with the sources the project lead supplied (checked 2026-11-22).
const pastConferences = [
  {
    name: 'OceanObs’99',
    text: 'OceanObs’99 rallied international support for Argo, the global fleet of floats that measures ocean temperature and salinity.',
    link: {
      text: 'IOC conference account (PDF)',
      href: 'https://www.jodc.go.jp/info/ioc_doc/INF/GOOS_081_Status_99.pdf',
    },
  },
  {
    name: 'OceanObs’09',
    text: 'OceanObs’09 led to the Framework for Ocean Observing, which provided the basis for transformation of observational data, organized into essential ocean variables, into information that serves a range of science and societal needs.',
    link: { text: 'Framework for Ocean Observing (PDF)', href: 'http://www.oceanobs09.net/foo/FOO_Report.pdf' },
  },
  {
    name: 'OceanObs’19',
    text: 'OceanObs’19 brought greater attention to marine life, ecosystems, and user needs. Community papers and breakouts helped advance initiatives such as the Observing Air-Sea Interactions Strategy, now a UN Ocean Decade programme.',
    link: { text: 'OceanObs’19 archive', href: 'https://oceanobs19.net/conference-archive' },
  },
];
---

<Layout metadata={metadata}>
  <PageHeader
    title="The OceanObs’29 conference"
    intro="OceanObs’29 brings together people who collect, share, and use ocean observations to identify gaps and set priorities for the next decade of observing. The conference is planned for Qingdao, China."
  />

  <!-- Taking part before the conference [brief] -->
  <section class="py-16 md:py-24" aria-labelledby="before">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 lg:grid-cols-12 lg:px-6">
      <div class="lg:col-span-5">
        <h2 id="before" class="scroll-mt-28 text-3xl font-bold tracking-tight text-heading md:text-4xl">
          Taking part before the conference
        </h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-lg text-default">
          You can help shape the agenda before the conference, even if you cannot travel. At the 2026 Ocean Sciences
          Meeting town hall in Glasgow, participants discussed observing priorities and gaps. See <a
            class={linkClass}
            href={`${getPermalink('/events')}#upcoming`}>News &amp; Events</a
          > for announced opportunities at other meetings, or <a
            class={linkClass}
            href={`${getPermalink('/get-involved')}#ways`}>share a priority in writing</a
          > with the Coordination Team. Tell us what needs to be measured, where coverage is missing, and who would use the
          information.
        </p>
        <!-- Add regional dialogues or virtual sessions here once a host, date and public participation route are confirmed. -->
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={getPermalink('/get-involved')} class="btn-site-primary">
            Get involved <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
          <a href={`${getPermalink('/events')}#upcoming`} class="btn-site-outline">
            News &amp; Events <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!--
    What a global conference makes possible [lead]: text supplied by the project lead (2026-11-22), moved here
    from the homepage on 2026-11-23 in place of "The OceanObs conference series". Keeps the #series anchor.
    "(PDF)" in link text added by Claude. The OceanObs’09 site has no HTTPS version, so that link stays http://.
  -->
  <section id="series" class="scroll-mt-28 bg-mist py-16 md:py-24" aria-labelledby="global-conference">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <div class="grid gap-8 lg:grid-cols-12">
        <h2
          id="global-conference"
          class="scroll-mt-28 text-3xl font-bold tracking-tight text-heading md:text-4xl lg:col-span-5"
        >
          What a global conference makes possible
        </h2>
        <p class="text-lg text-default lg:col-span-7">
          OceanObs gives the community a once-a-decade opportunity to agree on shared priorities, advance work that
          takes coordination across networks and regions, and start new partnerships and projects. Each conference has
          helped move a different part of that work forward.
        </p>
      </div>
      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        {
          pastConferences.map(({ name, text, link }) => (
            <li class="flex flex-col rounded-[4px] border-t-4 border-primary bg-white p-6 md:p-8">
              <h3 class="text-2xl font-extrabold tracking-tight text-heading">{name}</h3>
              <p class="mt-3 text-default">{text}</p>
              <a href={link.href} class:list={[cardLinkClass, 'mt-6 self-start md:mt-auto md:pt-6']}>
                {link.text}
                <Icon name="tabler:arrow-up-right" class="h-4 w-4 shrink-0" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
