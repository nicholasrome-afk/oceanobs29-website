---
// Homepage layout, in the order of the project brief's homepage sequence.
// Words live in src/config/home.ts and src/config/org.ts; photos in
// src/config/images.ts. Sections with no content are hidden.
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import EventCard from '~/components/site/EventCard.astro';
import NetworkCard from '~/components/site/NetworkCard.astro';
import PhotoCredit from '~/components/site/PhotoCredit.astro';

import { SITE, I18N } from 'astrowind:config';
import { ORG } from '~/config/org';
import { HOME } from '~/config/home';
import { IMAGES } from '~/config/images';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { getEvents, splitByTime } from '~/utils/events';

const metadata = { title: `${ORG.name}: Shaping the next decade of global ocean observing`, ignoreTitleTemplate: true };

// Live data under the map (written by `npm run map`, see docs/IMAGERY_PLAN.md).
type MapMeta = { retrieved: string; total: number; networks: { name: string; count: number; color: string }[] };
const mapFiles = import.meta.glob<{ default: MapMeta }>('../data/network-map.json', { eager: true });
const mapMeta = Object.values(mapFiles)[0]?.default;
const mapDate =
  mapMeta &&
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
    new Date(mapMeta.retrieved)
  );

// Legend: the four largest named networks, plus everything else, so the parts add up to the total.
const mapLegend = mapMeta ? mapMeta.networks.filter((n) => n.name !== 'Other').slice(0, 4) : [];
const mapOther = mapMeta ? mapMeta.total - mapLegend.reduce((sum, n) => sum + n.count, 0) : 0;

const label = (n: { data: { acronym?: string; name: string } }) => n.data.acronym ?? n.data.name;
const network = (await getCollection('network')).sort((a, b) => label(a).localeCompare(label(b)));

const events = await getEvents();
const { upcoming, past } = splitByTime(events);
const homeEvents = (upcoming.length ? upcoming : past).slice(0, 2);

const posts = await findLatestPosts({ count: 3 });
const buildYear = new Date().getFullYear();
// Timeline "Now": the latest step whose year has started, as of the build date.
const nowStepYear = HOME.timeline.steps.filter((step) => Number(step.year) <= buildYear).at(-1)?.year;
const postDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

// Structured data built only from config.yaml and src/config/org.ts: keep it true.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: ORG.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1. Hero: full-bleed ocean image, two-weight headline, place/year label, two calls to action -->
  <section class="relative isolate overflow-hidden bg-ink" aria-labelledby="hero-heading">
    <Image
      src={IMAGES.homeHero.src}
      alt={IMAGES.homeHero.alt}
      layout="none"
      loading="eager"
      fetchpriority="high"
      widths={[768, 1280, 1920, 2880]}
      sizes="100vw"
      style={IMAGES.homeHero.position ? `object-position: ${IMAGES.homeHero.position}` : undefined}
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <!-- Below 1280px an even 80% overlay (the clouds sit behind the text); wide screens: left-to-right gradient. Contrast-checked at 375/768/1024/1280/1440, 2026-10-18. -->
    <div
      class="absolute inset-0 -z-10 bg-ink/80 xl:bg-transparent xl:bg-linear-to-r xl:from-ink xl:via-ink/80 xl:to-ink/20"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-linear-to-t from-ink to-transparent" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl px-4 pt-20 pb-16 md:pt-32 md:pb-24 lg:px-6">
      <p
        class="inline-flex items-center gap-3 border border-accent/70 px-3 py-2 font-heading text-sm font-bold tracking-[0.14em] text-white uppercase"
      >
        <span>{HOME.hero.place}</span>
        <span class="h-4 w-px bg-accent" aria-hidden="true"></span>
        <span class="text-accent">{HOME.hero.year}</span>
      </p>
      <h1
        id="hero-heading"
        class="mt-8 max-w-5xl text-4xl leading-[1.02] tracking-tight text-white uppercase sm:text-5xl md:text-6xl lg:text-7xl"
      >
        <span class="block font-light text-on-dark">{HOME.hero.headlineLead}</span>
        <span class="block font-extrabold">{HOME.hero.headlineEmphasis}</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-on-dark md:text-xl">{HOME.hero.intro}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={getPermalink(HOME.hero.primary.href)} class="btn-site-accent">
          {HOME.hero.primary.text}
          <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </a>
        <a href={getPermalink(HOME.hero.secondary.href)} class="btn-site-outline-light">{HOME.hero.secondary.text}</a>
      </div>

      <!-- The decadal series, as a stat row -->
      <ol
        class="mt-16 grid max-w-3xl grid-cols-4 border-t border-white/15 pt-6"
        aria-label="The OceanObs conference series"
      >
        {
          HOME.vision.series.map(({ name, year, current }) => (
            <li>
              <p
                class:list={[
                  'font-heading text-2xl font-extrabold md:text-4xl',
                  current ? 'text-accent' : 'text-white/80',
                ]}
              >
                {name.replace('OceanObs', '')}
              </p>
              <p class="mt-1 text-xs tracking-[0.08em] text-on-dark-muted uppercase">
                <span class="sr-only">{name}, </span>
                {year}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
    <PhotoCredit image={IMAGES.homeHero} />
  </section>

  <!-- 2. The vision -->
  <section class="py-16 md:py-24" aria-labelledby="vision">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 lg:grid-cols-12 lg:px-6">
      <div class="lg:col-span-5">
        <p class="eyebrow-bar text-muted">{HOME.vision.eyebrow}</p>
        <h2 id="vision" class="mt-3 scroll-mt-28 text-3xl font-bold tracking-tight text-heading md:text-5xl">
          {HOME.vision.title}
        </h2>
      </div>
      <div class="lg:col-span-7">
        <p class="font-heading text-xl leading-relaxed font-semibold text-heading md:text-2xl">{HOME.vision.lead}</p>
        <p class="mt-6 text-lg text-muted">{HOME.vision.body}</p>
        <a
          href={getPermalink('/about')}
          class="mt-8 inline-flex items-center gap-1.5 font-semibold text-link underline-offset-4 hover:underline"
        >
          About OceanObs’29 <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- Expansive data image: the observing system as it is today -->
  {
    mapMeta && (
      <section class="relative bg-ink" aria-labelledby="map-heading">
        <figure>
          <Image
            src={IMAGES.networkMap.src}
            alt={IMAGES.networkMap.alt}
            layout="none"
            widths={[768, 1280, 1920, 2880]}
            sizes="100vw"
            class="h-auto w-full"
          />
          <figcaption class="mx-auto max-w-7xl px-4 pt-6 pb-12 md:pb-16 lg:px-6">
            <h2 id="map-heading" class="max-w-3xl text-on-dark">
              <span class="block font-heading text-5xl font-extrabold text-white md:text-7xl">
                {mapMeta.total.toLocaleString('en-GB')}
              </span>
              <span class="mt-2 block text-lg md:text-xl">
                ocean observing platforms reported a position in the 30 days to {mapDate}.
              </span>
            </h2>
            <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-on-dark-muted" aria-label="Largest networks">
              {mapLegend.map(({ name, count, color }) => (
                <li class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full" style={`background-color: ${color}`} aria-hidden="true" />
                  {name}: {count.toLocaleString('en-GB')}
                </li>
              ))}
              {mapOther > 0 && <li>Other platforms: {mapOther.toLocaleString('en-GB')}</li>}
            </ul>
            <p class="mt-5 text-xs text-on-dark-muted">
              Source:{' '}
              <a class="underline underline-offset-2 hover:text-on-dark" href={IMAGES.networkMap.sourceUrl}>
                OceanOPS (WMO-IOC)
              </a>
              . Land: Natural Earth.
            </p>
          </figcaption>
        </figure>
      </section>
    )
  }

  <!-- 3. Shaping the future: four visual cards -->
  <section class="bg-mist py-16 md:py-24" aria-labelledby="future">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead id="future" eyebrow={HOME.future.eyebrow} title={HOME.future.title} />
      <ol class="mt-10 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          HOME.future.cards.map(({ icon, title, text }, i) => (
            <li class="flex flex-col bg-white p-6 md:p-8">
              <div class="flex items-center justify-between">
                <Icon name={icon} class="h-9 w-9 text-primary" aria-hidden="true" />
                <span class="font-heading text-sm font-bold text-muted" aria-hidden="true">
                  0{i + 1}
                </span>
              </div>
              <h3 class="mt-8 text-xl font-bold text-heading">{title}</h3>
              <p class="mt-3 text-muted">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. Get involved: audience-specific cards on a dark band -->
  <section class="bg-ink py-16 md:py-24" aria-labelledby="involved">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="involved"
        dark
        eyebrow={HOME.involved.eyebrow}
        title={HOME.involved.title}
        intro={HOME.involved.intro}
        link={{ text: HOME.involved.link.text, href: getPermalink(HOME.involved.link.href) }}
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          HOME.involved.audiences.map(({ label, text }) => (
            <li class="flex flex-col rounded-[4px] border border-white/10 bg-ink-raised p-6 transition-colors hover:border-accent">
              <h3 class="font-heading text-xl leading-tight font-extrabold text-white uppercase">{label}</h3>
              <p class="mt-4 text-on-dark-muted">{text}</p>
            </li>
          ))
        }
      </ul>
      <a href={getPermalink(HOME.involved.link.href)} class="btn-site-accent mt-10">
        {HOME.hero.primary.text}
        <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- 5. Latest developments: news and events -->
  {
    (posts.length > 0 || homeEvents.length > 0) && (
      <section class="py-16 md:py-24" aria-labelledby="updates">
        <div class="mx-auto max-w-7xl px-4 lg:px-6">
          <SectionHead
            id="updates"
            eyebrow="News & events"
            title="Latest developments"
            link={{ text: 'All news & events', href: getPermalink('/events') }}
          />
          {posts.length > 0 && (
            <ul class="mt-10 grid border-t border-line md:grid-cols-3 md:border-t-0">
              {posts.map((post, i) => (
                <li
                  class:list={[
                    'border-b border-line py-6 md:border-t-4 md:border-b-0 md:border-t-primary md:pt-6 md:pb-0',
                    i > 0 && 'md:pl-8',
                    i < posts.length - 1 && 'md:pr-8',
                  ]}
                >
                  <p class="eyebrow text-muted">
                    {post.category?.title ?? 'News'} <span aria-hidden="true">|</span>{' '}
                    <time datetime={post.publishDate.toISOString()}>{postDate.format(post.publishDate)}</time>
                  </p>
                  <h3 class="mt-3 text-xl leading-snug font-bold text-heading">
                    <a
                      href={getPermalink(post.permalink, 'post')}
                      class="underline-offset-4 hover:text-link hover:underline"
                    >
                      {post.title}
                    </a>
                  </h3>
                  {post.excerpt && <p class="mt-2 text-muted">{post.excerpt}</p>}
                </li>
              ))}
            </ul>
          )}
          {homeEvents.length > 0 && (
            <>
              <h3 class="eyebrow mt-12 text-muted">{upcoming.length ? 'Upcoming events' : 'Recent events'}</h3>
              <ul class="mt-4 grid gap-4">
                {homeEvents.map((event) => (
                  <li>
                    <EventCard event={event} />
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </section>
    )
  }

  <!-- 6. Toward 2029: timeline -->
  <section class="bg-mist py-16 md:py-24" aria-labelledby="timeline">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead id="timeline" eyebrow={HOME.timeline.eyebrow} title={HOME.timeline.title} />
      <ol class="mt-12 grid gap-8 md:grid-cols-5 md:gap-0">
        {
          HOME.timeline.steps.map(({ year, title, text }) => {
            const current = year === nowStepYear;
            return (
              <li class="relative border-l-2 border-line pl-6 md:border-t-2 md:border-l-0 md:pt-8 md:pr-6 md:pl-0">
                <span
                  class:list={[
                    'absolute top-1 -left-[7px] h-3 w-3 rounded-full md:-top-[7px] md:left-0',
                    current ? 'bg-primary ring-4 ring-primary/20' : 'bg-line',
                  ]}
                  aria-hidden="true"
                />
                <p class:list={['font-heading text-3xl font-extrabold', current ? 'text-primary' : 'text-heading']}>
                  {year}
                  {current && <span class="eyebrow ml-2 align-middle text-link">Now</span>}
                </p>
                <h3 class="mt-2 text-lg font-bold text-heading">{title}</h3>
                <p class="mt-2 text-sm text-muted">{text}</p>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- 7. Partners: logos once named, plus the featured opportunity -->
  <section class="py-16 md:py-24" aria-labelledby="partners">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      {
        network.length > 0 && (
          <>
            <SectionHead eyebrow={HOME.network.eyebrow} title={HOME.network.title} />
            <ul class="mt-8 mb-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {network.map((item) => (
                <li>
                  <NetworkCard item={item} />
                </li>
              ))}
            </ul>
          </>
        )
      }
      <div class="grid overflow-hidden rounded-[4px] bg-primary text-white lg:grid-cols-12">
        <div class="p-8 md:p-12 lg:col-span-8">
          <p class="eyebrow text-white">{HOME.partner.eyebrow}</p>
          <h2 id="partners" class="mt-3 text-3xl font-extrabold tracking-tight uppercase md:text-5xl">
            {HOME.partner.title}
          </h2>
          <p class="mt-5 max-w-2xl text-lg text-white">{HOME.partner.text}</p>
        </div>
        <div
          class="flex flex-col justify-end gap-3 border-t border-white/15 p-8 md:p-12 lg:col-span-4 lg:border-t-0 lg:border-l"
        >
          <a href={getPermalink(HOME.partner.link.href)} class="btn-site-light justify-center">
            {HOME.partner.link.text}
            <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
          <a href={HOME.partner.contact.href} class="btn-site-outline-light justify-center">
            <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" />
            {HOME.partner.contact.text}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Stay connected -->
  <section class="border-t border-line py-16 md:py-20" aria-labelledby="connect">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 md:flex-row md:items-end md:justify-between lg:px-6">
      <div class="max-w-2xl">
        <p class="eyebrow-bar text-muted">{HOME.connect.eyebrow}</p>
        <h2 id="connect" class="mt-3 text-3xl font-bold tracking-tight text-heading md:text-4xl">
          {HOME.connect.title}
        </h2>
        <p class="mt-4 text-lg text-muted">{HOME.connect.text}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        {
          ORG.contacts.map(({ email }) => (
            <a href={`mailto:${email}`} class="btn-site-primary">
              <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" />
              {email}
            </a>
          ))
        }
        {
          ORG.social
            .filter((s) => s.href)
            .map(({ name, icon, href }) => (
              <a href={href} class="btn-site-outline">
                <Icon name={icon} class="h-4 w-4" aria-hidden="true" />
                {name}
              </a>
            ))
        }
      </div>
    </div>
  </section>
</Layout>
