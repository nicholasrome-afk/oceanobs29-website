---
// Thin bar above the header (after Ocean Networks Canada's utility bar): keeps
// the host credit, key external links and the newsletter one click away
// without crowding the main menu. Renders nothing if there is nothing to show.
import { Icon } from 'astro-icon/components';
import { ORG } from '~/config/org';

const show = ORG.host.name || ORG.utilityLinks.length || ORG.newsletterUrl;
---

{
  show && (
    <div class="bg-ink text-on-dark-muted">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-3 py-2 text-xs lg:px-6">
        {ORG.host.name && (
          <p class="eyebrow hidden text-[0.6875rem] md:block">
            Hosted by{' '}
            <a class="text-on-dark hover:underline" href={ORG.host.url}>
              {ORG.host.name}
            </a>
          </p>
        )}
        <ul class="ml-auto flex items-center gap-5">
          {ORG.utilityLinks.map(({ text, href }) => (
            <li>
              <a class="inline-flex items-center gap-1 text-on-dark hover:underline" href={href}>
                {text} <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5" aria-hidden="true" />
              </a>
            </li>
          ))}
          {ORG.newsletterUrl && (
            <li>
              <a
                class="inline-flex items-center gap-1 rounded-[3px] bg-accent px-2.5 py-1 font-semibold text-ink hover:bg-white"
                href={ORG.newsletterUrl}
              >
                <Icon name="tabler:mail" class="h-3.5 w-3.5" aria-hidden="true" /> Newsletter
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>
  )
}
