---
// Placeholder for sections planned in the site map but not built yet
// (Phase 3). Lists what the section will hold, from the project brief.
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import { ORG } from '~/config/org';

export interface Props {
  title: string;
  intro: string;
  willInclude: string[];
}

const { title, intro, willInclude } = Astro.props;
---

<Layout metadata={{ title, robots: { index: false, follow: true } }}>
  <PageHeader eyebrow="OceanObs’29" title={title} intro={intro} />
  <section class="py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 md:grid-cols-2 lg:px-6">
      <div>
        <h2 class="text-2xl font-bold text-heading">Coming to this section</h2>
        <ul class="mt-6 space-y-3">
          {
            willInclude.map((item) => (
              <li class="flex gap-3 text-lg text-default">
                <Icon name="tabler:point-filled" class="mt-1.5 h-4 w-4 shrink-0 text-link" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="self-start rounded-[4px] bg-mist p-8">
        <p class="text-lg text-default">In the meantime, the coordination team is happy to help.</p>
        <a href={`mailto:${ORG.contacts[0].email}`} class="btn-site-primary mt-6">
          <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" />
          {ORG.contacts[0].email}
        </a>
      </div>
    </div>
  </section>
</Layout>
