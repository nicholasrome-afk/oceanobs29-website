---
// Site footer: newsletter band → logo strip → dark footer with contacts and
// quick links (after MBARI's footer). Each part hides itself when its data in
// src/config/org.ts is empty.
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import { ORG } from '~/config/org';
import { footerData } from '~/navigation';

const year = new Date().getFullYear();
---

<footer>
  {
    ORG.newsletterUrl && (
      <section class="bg-primary text-white" aria-labelledby="newsletter-heading">
        <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 md:flex-row md:items-center md:justify-between lg:px-6">
          <div>
            <p class="eyebrow text-white">Newsletter</p>
            <h2 id="newsletter-heading" class="mt-2 text-2xl font-bold md:text-3xl">
              Stay in touch
            </h2>
            <p class="mt-2 max-w-xl text-white">News, events and opportunities, straight to your inbox.</p>
          </div>
          <a class="btn-site-light shrink-0" href={ORG.newsletterUrl}>
            <Icon name="tabler:mail" class="h-4 w-4" aria-hidden="true" /> Subscribe
          </a>
        </div>
      </section>
    )
  }

  {
    ORG.footerLogos.length > 0 && (
      <section class="border-b border-line bg-white" aria-label="Host and partners">
        <ul class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 py-10 sm:grid-cols-3 lg:px-6">
          {ORG.footerLogos.map(({ label, src, alt, href }) => (
            <li class="flex flex-col items-center gap-3 text-center">
              <span class="eyebrow text-muted">{label}</span>
              <a href={href} class="flex h-20 items-center">
                <Image src={src} alt={alt} layout="none" width={240} class="max-h-20 w-auto object-contain" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="bg-ink text-on-dark-muted">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 md:grid-cols-12 lg:px-6">
      <div class="md:col-span-5">
        <p class="font-heading text-2xl font-extrabold tracking-tight text-on-dark">{ORG.shortName}</p>
        {ORG.status && <p class="mt-3 max-w-sm text-sm">{ORG.status}</p>}
        {
          ORG.contacts.length > 0 && (
            <>
              <h2 class="eyebrow mt-8 text-on-dark">{ORG.contactsHeading}</h2>
              <ul class="mt-3 space-y-2 text-sm">
                {ORG.contacts.map(({ name, role, email }) => (
                  <li>
                    {name}
                    {role && `, ${role}`},{' '}
                    <a class="text-on-dark-link underline-offset-2 hover:underline" href={`mailto:${email}`}>
                      {email}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>

      {
        footerData.homeSections.length > 0 && (
          <nav class="md:col-span-3" aria-label="Homepage sections">
            <h2 class="eyebrow text-on-dark">On the homepage</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {footerData.homeSections.map(({ text, href }) => (
                <li>
                  <a class="hover:text-on-dark hover:underline" href={href}>
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        footerData.sections.map(({ title, links }) => (
          <nav class="md:col-span-2" aria-label={title}>
            <h2 class="eyebrow text-on-dark">{title}</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {links.map(({ text, href }) => (
                <li>
                  <a class="hover:text-on-dark hover:underline" href={href}>
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="border-t border-white/10">
      <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 text-xs sm:flex-row sm:justify-between lg:px-6">
        <p>© {year} {ORG.name}</p>
        {
          ORG.footerNote.text && (
            <p>
              {ORG.footerNote.href ? (
                <a class="hover:text-on-dark hover:underline" href={ORG.footerNote.href}>
                  {ORG.footerNote.text}
                </a>
              ) : (
                ORG.footerNote.text
              )}
            </p>
          )
        }
      </div>
    </div>
  </div>
</footer>
